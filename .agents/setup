#!/usr/bin/env bash
# Prepares a fresh Amp orb: pnpm 8 (matches the v6 lockfile) and node_modules.
set -euo pipefail
cd "$(dirname "$0")/.."

PNPM_VERSION=8.15.9

step() { echo "==> $*"; }
timed() { local start=$SECONDS; "$@"; echo "    (${*:1:3}: $((SECONDS - start))s)"; }

# pnpm-lock.yaml is lockfileVersion 6.0, which pnpm 8 writes; newer pnpm would rewrite it.
# ~/.local/bin precedes /usr/local/bin on the orb PATH, so this shadows the preinstalled pnpm.
if [ "$("$HOME/.local/bin/pnpm" --version 2>/dev/null || true)" != "$PNPM_VERSION" ]; then
  step "Installing pnpm $PNPM_VERSION into ~/.local"
  timed npm install --global --prefix "$HOME/.local" --no-fund --no-audit "pnpm@$PNPM_VERSION"
fi
export PATH="$HOME/.local/bin:$PATH"

step "Installing dependencies (node $(node --version), pnpm $(pnpm --version))"
timed pnpm install --frozen-lockfile --prefer-offline
